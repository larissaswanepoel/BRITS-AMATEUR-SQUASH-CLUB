rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/settings/admin).data;
    }

    function isOwner() {
      return signedIn() && adminDoc().ownerUid == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && (isOwner() || request.auth.uid in adminDoc().uids);
    }

    match /settings/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/settings/admin)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner();
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || signedIn();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
